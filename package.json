{
  "name": "mcp-roadmapsh",
  "version": "0.1.0",
  "description": "MCP server for roadmap.sh — developer roadmaps, best practices, interview questions, projects and progress tracking",
  "mcpName": "io.github.aissablk1/mcp-roadmapsh",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "mcp-server",
    "roadmap",
    "roadmap.sh",
    "developer-roadmap",
    "learning",
    "education",
    "claude",
    "claude-code",
    "ai",
    "llm",
    "anthropic"
  ],
  "author": "Aïssa BELKOUSSA",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/aissablk1/mcp-roadmapsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aissablk1/mcp-roadmapsh.git"
  },
  "bugs": {
    "url": "https://github.com/aissablk1/mcp-roadmapsh/issues"
  },
  "bin": {
    "mcp-roadmapsh": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROJECT.nfo",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
